<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Secure Checkout - Calvoro</title>
    <style>
        :root {
            --color-primary: #111;
            --color-text: #111;
            --color-text-muted: #666;
            --color-bg: #ffffff;
            --color-border: #eeeeee;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background: var(--color-bg);
            color: var(--color-text);
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            margin: 0;
            padding: 20px;
        }

        .checkout-container {
            text-align: center;
            max-width: 440px;
            width: 100%;
            padding: 60px 40px;
        }

        .shield-icon {
            width: 80px;
            height: 80px;
            margin: 0 auto 32px;
            color: var(--color-primary);
        }

        .shield-icon svg {
            width: 100%;
            height: 100%;
            stroke-width: 1.5;
        }

        h1 {
            font-size: 28px;
            font-weight: 700;
            margin: 0 0 16px;
            letter-spacing: -0.02em;
        }

        p {
            font-size: 15px;
            line-height: 1.6;
            color: var(--color-text-muted);
            margin: 0 0 40px;
        }

        .spinner-container {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 16px;
        }

        .spinner {
            width: 28px;
            height: 28px;
            border: 2px solid #f3f3f3;
            border-top: 2px solid var(--color-primary);
            border-radius: 50%;
            animation: spin 0.8s cubic-bezier(0.4, 0, 0.2, 1) infinite;
        }

        .spinner-text {
            font-size: 13px;
            font-weight: 500;
            color: var(--color-text-muted);
            letter-spacing: 0.05em;
            text-transform: uppercase;
        }

        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        .footer-note {
            margin-top: 60px;
            font-size: 12px;
            color: #999;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .logo {
            position: absolute;
            top: 40px;
            left: 50%;
            transform: translateX(-50%);
        }

        .logo img {
            height: 24px;
            opacity: 0.8;
        }
    </style>
</head>

<body>
    <div class="logo">
        <img src="https://calvorosl.com/logo.png" alt="CALVORO">
    </div>

    <div class="checkout-container">
        <div class="shield-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                <polyline points="9 11 12 14 15 10"></polyline>
            </svg>
        </div>

        <h1>Secure Checkout</h1>
        <p>Secure Payhere Checkout. We'll email you a confirmation after payment.</p>

        <div class="spinner-container">
            <div class="spinner"></div>
            <div class="spinner-text">Redirecting to Payment Gateway</div>
        </div>

        <div class="footer-note">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
            SSL Secure Connection
        </div>
    </div>

    <!-- Hidden PayHere Form -->
    <form method="post" action="<%= payhere_url %>" id="payhere-form">
        <!-- Merchant Details -->
        <input type="hidden" name="merchant_id" value="<%= merchant_id %>">

        <!-- Return URLs -->
        <input type="hidden" name="return_url" value="<%= return_url %>">
        <input type="hidden" name="cancel_url" value="<%= cancel_url %>">
        <input type="hidden" name="notify_url" value="<%= notify_url %>">

        <!-- Order Details -->
        <input type="hidden" name="order_id" value="<%= order_id %>">
        <input type="hidden" name="items" value="<%= items %>">
        <input type="hidden" name="currency" value="<%= currency %>">
        <input type="hidden" name="amount" value="<%= amount %>">

        <!-- Customer Details -->
        <input type="hidden" name="first_name" value="<%= first_name %>">
        <input type="hidden" name="last_name" value="<%= last_name %>">
        <input type="hidden" name="email" value="<%= email %>">
        <input type="hidden" name="phone" value="<%= phone %>">
        <input type="hidden" name="address" value="<%= address %>">
        <input type="hidden" name="city" value="<%= city %>">
        <input type="hidden" name="country" value="<%= country %>">

        <!-- Security Hash -->
        <input type="hidden" name="hash" value="<%= hash %>">
    </form>

    <script>
        // Auto-submit form after a brief delay
        setTimeout(function () {
            document.getElementById('payhere-form').submit();
        }, 1500);
    </script>
</body>

</html>